HEDERA_NETWORK=hedera:testnet
FACILITATOR_ACCOUNT_ID=0.0.xxxx
FACILITATOR_PRIVATE_KEY=0x...
AGENT_ACCOUNT_ID=0.0.xxxx
AGENT_PRIVATE_KEY=0x...
MERCHANT_ACCOUNT_ID=0.0.xxxx
MERCHANT_PRIVATE_KEY=0x...
ATTACKER_ACCOUNT_ID=0.0.xxxx
ATTACKER_PRIVATE_KEY=0x...
USDC_TOKEN_ID=0.0.429274
HCS_TOPIC_ID=0.0.xxxx
PAYMENT_AMOUNT=10000
# Trusted quote baseline map. Defaults to RESOURCE_URL/credits at PAYMENT_AMOUNT.
# SENTINEL_LISTED_PRICES_JSON={"http://127.0.0.1:4021/credits":"10000"}
# SENTINEL_PRICE_TOLERANCE_PCT=10
# B7 defaults: 1 USDC single payment, 10 USDC rolling daily cap, 10 payments per minute.
# SENTINEL_MAX_SINGLE_PAYMENT=1000000
# SENTINEL_DAILY_CAP=10000000
# SENTINEL_VELOCITY_LIMIT=10
# SR6/SR5 guardrails: 2 HBAR maximum fee and Hedera's default 120-second validity window.
SENTINEL_MAX_TX_FEE_TINYBARS=200000000
SENTINEL_MAX_TX_VALID_DURATION_SECONDS=120
BUY_CREDITS_ALLOWLIST=0.0.merchant
SWAP_ALLOWLIST=
FACILITATOR_PORT=4020
RESOURCE_PORT=4021
# Optional. Portal personal access token. Lets bootstrap fund a new ECDSA account.
# HEDERA_PAT=
